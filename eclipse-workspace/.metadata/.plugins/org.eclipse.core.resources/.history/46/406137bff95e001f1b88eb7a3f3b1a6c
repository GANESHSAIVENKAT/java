package com.google.xworkz.test;

public class Phone extends Mobile{
    @Override
    public void display() {
        System.out.println("Phone display method");
    }

    // Constructor Overloading
    Phone() {
        super(); 
        System.out.println("Phone class no-arg constructor");
    }

    public Phone(String brand) {
        super(brand); // Calls Base class constructor with a message
        System.out.println("Phone class constructor with message: " + brand);
    }

    // Constructor Chaining (within the same class)
    public Phone(String brand, int price) {
        this(brand); // Calls another constructor in the same class
        System.out.println("Derived class constructor with message and number: " + brand + ", " + price);
    }

    // Method Chaining
    public Phone setMessage(String brand) {
        System.out.println("Setting message: " + brand);
        return this; // Returning the current instance
    }

    public Phone setNumber(int price) {
        System.out.println("Setting number: " + price);
        return this; // Returning the current instance
    }

    @Override
    public int hashCode() {
        return 42;
    }

    @Override
    public boolean equals(Object obj) {
        if (this == obj) return true;
        if (obj == null || getClass() != obj.getClass()) return false;
        return true;
    }

    @Override
    public String toString() {
        return "Phone class instance";
    }

}

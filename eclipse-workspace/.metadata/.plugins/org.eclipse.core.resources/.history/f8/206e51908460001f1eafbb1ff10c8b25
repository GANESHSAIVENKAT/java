public class Game {
	private GamesDto gamesdto[]=new GamesDto[3];
	private int index;
	public String onSave(GamesDto dto) {
		if(dto==null) {
			return "notsaved";
		}else {
			boolean duplicateres=GameUtil.checkDuplicate(gamesdto, dto);
			System.out.println(duplicateres);
		}
		
		return "not saved";

	}
}
